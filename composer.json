{
    "name": "acolasialiuliu/flarum-ext-chat",
    "description": "Realtime Chat for Flarum 2.0 (Forked from MissGamerz/Xelson, fully adapted for Flarum 2.0 RC)",
    "keywords": [
        "chat",
        "flarum",
        "flarum-2.0",
        "xelson",
        "push-edx",
        "neon-chat",
        "realtime"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/acolasialiuliu/flarum-ext-chat/issues",
        "source": "https://github.com/acolasialiuliu/flarum-ext-chat"
    },
    "authors": [
        {
            "name": "Juan"
        },
        {
            "name": "Guillem Pascual",
            "email": "blipi.tube@gmail.com",
            "homepage": "http://pushedx.net"
        },
        {
            "name": "Xelson",
            "homepage": "https://neonsky.ru"
        },
        {
            "name": "MissGamerz",
            "homepage": "https://networkforgamers.com"
        },
        {
            "name": "acolasialiuliu"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "extra": {
        "flarum-extension": {
            "id": "xelson-chat",
            "title": "Neon Chat (Flarum 2.0)",
            "category": "feature",
            "icon": {
